# =============================================================================
# ARTHSAVORA BACKEND CONFIGURATION
# Copy this file to .env and configure for your local environment
# =============================================================================

# Application
PROJECT_NAME=ARTHSAVORA
ENVIRONMENT=development
DEBUG=true

# Security (Generate a secure random string in production: openssl rand -hex 32)
SECRET_KEY=arthsavora-dev-insecure-secret-key-change-in-production-12345678
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# PostgreSQL (Primary Relational Database & Single Financial Source of Truth)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=arthsavora
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/arthsavora

# Legacy MongoDB (Maintained for transitional data extraction)
MONGODB_URL=mongodb://localhost:27017/arthsavora

# Redis & Celery (Asynchronous Task Queue)
REDIS_URL=redis://localhost:6379/0

# Supabase Storage (Receipts & Document Ingestion)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_RECEIPTS_BUCKET=receipts

# Google GenAI (Financial Chatbot & Smart Categorization)
GEMINI_API_KEY=your-google-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Tesseract OCR (Optional: Specify path if not in system PATH)
# Windows Example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux Example: /usr/bin/tesseract
TESSERACT_CMD=
